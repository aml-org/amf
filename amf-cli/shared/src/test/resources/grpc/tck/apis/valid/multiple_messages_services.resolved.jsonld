              {
                "@value": "syntax = \"proto3\";\npackage foo;\n\n\nmessage Request1 {\n  string query = 1;\n}\n\nmessage Response1 {\n  string result = 1;\n}\n\nmessage Request2 {\n  int32 id = 1;\n}\n\nmessage Response2 {\n  bool success = 1;\n}\n\nservice Service1 {\n  rpc Method1(Request1) returns (Response1);\n  rpc Method2(Request2) returns (Response2);\n}\n\nservice Service2 {\n  rpc AnotherMethod(Request1) returns (Response2);\n}\n"
              }
            ]
          }
