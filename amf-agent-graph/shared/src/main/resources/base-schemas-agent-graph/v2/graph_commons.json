{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Common graph definitions",
  "@context": {
    "@base": "http://anypoint.com/vocabs/graph#"
  },
  "definitions": {
    "BaseTrigger": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "A unique identifier for the object instance within its context."
        },
        "label": {
          "type": "string",
          "description": "An optional short, human-readable display name for the node"
        },
        "description": {
          "type": "string",
          "description": "A CommonMark string providing a description of the node."
        },
        "to": {
          "type": "string",
          "description": "The if of the node where the trigger will start."
        }
      }
    },
    "BaseNode": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/graph#ReferenceHolder",
          "http://anypoint.com/vocabs/graph/reference/key/kind#to/node",
          "http://anypoint.com/vocabs/graph#DeclarationHolder",
          "http://anypoint.com/vocabs/graph/declaration/key/kind#id/node"
        ]
      },
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "A unique identifier for the object instance within its context."
        },
        "to": {
          "type": "string",
          "description": "The id of the node where it will continue once it has finished."
        },
        "label": {
          "type": "string",
          "description": "An optional short, human-readable display name for the node"
        },
        "description": {
          "type": "string",
          "description": "A CommonMark string providing a description of the node."
        }
      },
      "required": [
        "id",
        "to"
      ]
    },
    "PolicyBindingRef": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#Reference",
          "http://anypoint.com/vocabs/agents/reference/kind#policybinding"
        ],
        "@base": "http://anypoint.com/vocabs/agents#"
      },
      "description": "The reference to a declared policy binding",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "PolicyBinding": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#PolicyBinding"
        ]
      },
      "description": "The policy to be applied",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "configuration"
      ],
      "properties": {
        "ref": {
          "$ref": "../references.json#/definitions/PolicyRef"
        },
        "configuration": {
          "type": "object"
        }
      }
    },
    "Policies": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/PolicyBindingRef"
          },
          {
            "type": "object",
            "properties": {
              "policy": {
                "$ref": "#/definitions/PolicyBinding"
              }
            }
          }
        ]
      }
    }
  }
}
