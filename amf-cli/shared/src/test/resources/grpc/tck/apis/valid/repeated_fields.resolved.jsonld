              {
                "@value": "file://amf-cli/shared/src/test/resources/grpc/tck/apis/valid/repeated_fields.proto"
              }
            ],
            "http://a.ml/vocabularies/document-source-maps#value": [
              {
                "@value": "syntax = \"proto3\";\n\npackage foo;\n\nmessage RepeatedFields {\n  repeated int32 int_list = 1;\n  repeated string string_list = 2;\n  repeated NestedMessage message_list = 3;\n  repeated NestedEnum enum_list = 4;\n}\n\nmessage NestedMessage {\n  int32 value = 1;\n}\n\nenum NestedEnum {\n  NESTED_UNKNOWN = 0;\n  NESTED_VALUE = 1;\n}\n"
              }
            ]
          }
        ]
      }
    ],
