      ],
      "http://a.ml/vocabularies/core#protocolVersion": "0.2.9",
      "http://a.ml/vocabularies/core#name": "Employee Onboarding Broker",
      "http://a.ml/vocabularies/core#description": "This agent acts as a broker for employee onboarding, orchestrating the process by leveraging various available tools to ensure new employees are registered with all the systems required for their daily operations.",
      "http://a.ml/vocabularies/core#url": "${agentregistry.url}/employee-onboarding-conductor",
      "http://a.ml/vocabularies/core#provider": {
        "@id": "file://amf-broker-group/shared/src/test/resources/instances/valid/instance_2.yaml#/encodes/brokers/employee-onboarding-broker/card/provider"
      },
