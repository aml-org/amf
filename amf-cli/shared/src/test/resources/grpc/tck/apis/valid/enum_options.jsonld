              {
                "@value": "syntax = \"proto3\";\npackage foo;\n\n\nenum DeprecatedEnum {\n  option deprecated = true;\n  DEPRECATED_UNKNOWN = 0;\n  DEPRECATED_VALUE = 1;\n}\n\nenum EnumWithDeprecatedValue {\n  VALUE_UNKNOWN = 0;\n  VALUE_ACTIVE = 1;\n  VALUE_OLD = 2 [deprecated = true];\n}\n"
              }
            ]
