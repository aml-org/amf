              {
                "@value": "syntax = \"proto3\";\npackage foo;\n\n\nmessage MethodRequest {\n  string query = 1;\n}\n\nmessage MethodResponse {\n  string result = 1;\n}\n\nservice OptionsService {\n  option deprecated = true;\n  \n  rpc DeprecatedMethod(MethodRequest) returns (MethodResponse) {\n    option deprecated = true;\n  }\n  \n  rpc IdempotentMethod(MethodRequest) returns (MethodResponse) {\n    option idempotency_level = IDEMPOTENT;\n  }\n  \n  rpc NoSideEffectsMethod(MethodRequest) returns (MethodResponse) {\n    option idempotency_level = NO_SIDE_EFFECTS;\n  }\n}\n"
              }
            ]
          }
        ]
      }
