          {
            "@id": "file://amf-cli/shared/src/test/resources/upanddown/grpc/google/field_mask.proto#/source-map/grpc-raw-proto/element_0",
            "http://a.ml/vocabularies/document-source-maps#element": [
              {
                "@value": "file://amf-cli/shared/src/test/resources/upanddown/grpc/google/field_mask.proto"
