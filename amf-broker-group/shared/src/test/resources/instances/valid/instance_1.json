{
  "ansVersion": "1.0.0",
  "brokers": {
    "google-maps-agent": {
      "card": {
        "protocolVersion": "0.2.9",
        "name": "GeoSpatial Route Planner Agent",
        "description": "Provides advanced route planning, traffic analysis, and custom map generation services. This agent can calculate optimal routes, estimate travel times considering real-time traffic, and create personalized maps with points of interest.",
        "url": "https://${ingressgw.url}/a2a/maps/v1",
        "capabilities": {},
        "version": "1.0.0",
        "provider": {
          "organization": "Acme Inc.",
          "url": "https://www.acme.com"
        },
        "securitySchemes": {
          "oAuth2ClientCredentials": {
            "type": "oauth2",
            "flows": {
              "clientCredentials": {
                "tokenUrl": "https://${envUrl}/token",
                "scopes": {
                  "read": "Grants read access"
                }
              }
            }
          }
        },
        "security": [
          {
            "oAuth2ClientCredentials": [
              "openid",
              "profile",
              "email"
            ]
          }
        ],
        "defaultInputModes": [
          "application/json",
          "text/plain"
        ],
        "defaultOutputModes": [
          "application/json",
          "image/png"
        ],
        "skills": [
          {
            "id": "route-optimizer-traffic",
            "name": "Traffic-Aware Route Optimizer",
            "description": "Calculates the optimal driving route between two or more locations, taking into account real-time traffic conditions, road closures, and user preferences (e.g., avoid tolls, prefer highways).",
            "examples": [
              "Plan a route from '1600 Amphitheatre Parkway, Mountain View, CA' to 'San Francisco International Airport' avoiding tolls.",
              "{\"origin\": {\"lat\": 37.422, \"lng\": -122.084}, \"destination\": {\"lat\": 37.7749, \"lng\": -122.4194}, \"preferences\": [\"avoid_ferries\"]}"
            ],
            "inputModes": [
              "application/json",
              "text/plain"
            ],
            "outputModes": [
              "application/json",
              "application/vnd.geo+json",
              "text/html"
            ],
            "tags": [
              "maps"
            ]
          }
        ]
      },
      "spec": {
        "llmRef": {
          "name": "my-einstein"
        },
        "maxNumberOfLoops": 10,
        "maxConsecutiveErrors": 1,
        "instructions": [
          "You're mission is helping people find the best route possible between two points. You will extract origin and destination",
          "If the user didn't say otherwise, assume they are traveling by car. Valid transportation means are Car, Bicycle, walking, and public transport.",
          "If the user says they're riding a motorcycle, treat it the same as cars.",
          "When presenting routes, present the one with the lowest total distance, the one with the lowest fuel consumption, and the fastest one.",
          "Check the weather in the areas involved in the route and show a warning if there are any weather alerts."
        ],
        "tools": [
          {
            "mcpRef": {
              "name": "google-maps-mcp"
            },
            "allowed": [
              "geocode",
              "trace-route",
              "render-route"
            ]
          }
        ],
        "links": [
          {
            "agentRef": {
              "name": "weather-agent"
            }
          }
        ],
        "policies": [
          {
            "policyRef": {
              "name": "rate-limit"
            },
            "config": null
          }
        ]
      }
    }
  },
  "agents": {
    "test-agent": {
      "platform": "bedrock",
      "links": [
        {
          "agentRef": {
            "name": "???"
          }
        }
      ]
    },
    "weather-agent": {
      "platform": "gemini",
      "links": [
        {
          "agentRef": {
            "name": "???"
          }
        }
      ]
    },
    "sf-crm-agent": {
      "platform": "agentforce",
      "protocol": "a2a",
      "links": [
        {
          "agentRef": {
            "name": "???"
          }
        }
      ]
    }
  },
  "mcps": {
    "weather-mcp": {
      "transport": {
        "kind": "sse",
        "ssePath": "/sse",
        "messagesPath": "/messages"
      }
    }
  },
  "llms": {
    "my-enistein": {
      "kind": "einstein",
      "description": "This is a description of the llm."
    }
  },
  "connections": {
    "test-agent": {
      "kind": "agent",
      "agentRef": {
        "name": "test-agent"
      },
      "spec": {
        "url": "https://weather-agent.anypoint.mulesoft.com/",
        "authentication": {
          "kind": "oauth2-client-credentials",
          "clientId": "${weather.clientId}",
          "clientSecret": "${weather.clientSecret}",
          "tokenUrl": "${weather.tokenUrl}"
        },
        "policies": [
          {
            "policyRef": {
              "name": "rate-limit"
            },
            "config": {
              "requests": 100,
              "timeWindow": 60
            }
          }
        ]
      }
    },
    "my-einstein": {
      "kind": "llm",
      "llmRef": {
        "name": "my-enistein"
      },
      "spec": {
        "kind": "openai",
        "modelName": "gpt5-mini",
        "authentication": {
          "apiKey": "${openai.apiKey}"
        }
      }
    },
    "anypoint-agent": {
      "kind": "agent",
      "spec": {
        "url": "www.anypoint.com/a2a/"
      }
    },
    "weather-mcp": {
      "kind": "mcp",
      "spec": {
        "url": "https://weather-mcp.anypoint.com/"
      }
    },
    "google-maps-mcp": {
      "kind": "mcp",
      "spec": {
        "url": "https://maps.google.com/mcp"
      }
    }
  }
}
