                "@value": "file://amf-cli/shared/src/test/resources/grpc/tck/apis/valid/reserved_fields.proto"
              }
            ],
            "http://a.ml/vocabularies/document-source-maps#value": [
              {
                "@value": "syntax = \"proto3\";\npackage foo;\n\n\nmessage ReservedMessage {\n  reserved 2, 15, 9 to 11;\n  reserved \"foo\", \"bar\";\n  \n  int32 field1 = 1;\n  int32 field3 = 3;\n  int32 field8 = 8;\n  int32 field12 = 12;\n}\n\nenum ReservedEnum {\n  RESERVED_UNKNOWN = 0;\n  reserved 2, 15, 9 to 11;\n  reserved \"OLD_NAME\", \"DEPRECATED\";\n  \n  VALUE1 = 1;\n  VALUE3 = 3;\n}\n"
              }
            ]
          }
        ]
      }
    ],
