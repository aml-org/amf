            ],
            "http://a.ml/vocabularies/document-source-maps#value": [
              {
                "@value": "syntax = \"proto3\";\npackage foo;\n\n\nmessage Request {\n  string query = 1;\n  int32 page_size = 2;\n}\n\nmessage Response {\n  repeated string results = 1;\n  int32 total_count = 2;\n}\n\nservice SearchService {\n  rpc Search(Request) returns (Response);\n  rpc GetStatus(Request) returns (Response);\n}\n"
              }
            ]
          }
        ]
      }
