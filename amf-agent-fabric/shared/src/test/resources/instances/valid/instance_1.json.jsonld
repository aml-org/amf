],
"http://a.ml/vocabularies/core#protocolVersion": "0.2.9",
"http://a.ml/vocabularies/core#name": "GeoSpatial Route Planner Agent",
"http://a.ml/vocabularies/core#description": "Provides advanced route planning, traffic analysis, and custom map generation services. This agent can calculate optimal routes, estimate travel times considering real-time traffic, and create personalized maps with points of interest.",
"http://a.ml/vocabularies/core#url": "https://acme.com/a2a/maps/v1",
"http://a.ml/vocabularies/core#capabilities": {
"@id": "file://amf-agent-fabric/shared/src/test/resources/instances/valid/instance_1.json#/encodes/agents/google-maps-agent/card/capabilities"
},
