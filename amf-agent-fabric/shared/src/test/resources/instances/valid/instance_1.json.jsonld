"http://a.ml/vocabularies/core#id": "route-optimizer-traffic",
"http://a.ml/vocabularies/core#name": "Traffic-Aware Route Optimizer",
"http://a.ml/vocabularies/core#description": "Calculates the optimal driving route between two or more locations, taking into account real-time traffic conditions, road closures, and user preferences (e.g., avoid tolls, prefer highways).",
"http://a.ml/vocabularies/core#examples": [
"Plan a route from '1600 Amphitheatre Parkway, Mountain View, CA' to 'San Francisco International Airport' avoiding tolls.",
"{\"origin\": {\"lat\": 37.422, \"lng\": -122.084}, \"destination\": {\"lat\": 37.7749, \"lng\": -122.4194}, \"preferences\": [\"avoid_ferries\"]}"
],
"http://a.ml/vocabularies/core#inputModes": [
"application/json",
"text/plain"
],
"http://a.ml/vocabularies/core#outputModes": [
"application/json",
"application/vnd.geo+json",
"text/html"
],
"http://a.ml/vocabularies/core#tags": [
"maps"
]
},
{
"@id": "file://amf-agent-fabric/shared/src/test/resources/instances/valid/instance_1.json#/encodes/agents/google-maps-agent/spec/tools/0",
"@type": [
"http://a.ml/vocabularies/core#tools",
"http://a.ml/vocabularies/document#JsonLDObject"
