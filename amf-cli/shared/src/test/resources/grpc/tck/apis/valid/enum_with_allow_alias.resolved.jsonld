              {
                "@value": "syntax = \"proto3\";\n\npackage foo;\n\nenum AliasedEnum {\n  option allow_alias = true;\n  ALIASED_UNKNOWN = 0;\n  ALIASED_VALUE = 1;\n  ALIASED_ALIAS = 1;\n  ALIASED_ANOTHER = 2;\n}\n\nmessage EnumAliasMessage {\n  AliasedEnum value = 1;\n}\n"
              }
