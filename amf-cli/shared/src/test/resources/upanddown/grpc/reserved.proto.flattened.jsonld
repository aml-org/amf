    {
      "@id": "file://amf-cli/shared/src/test/resources/upanddown/grpc/reserved.proto#/source-map/synthesized-field/element_0",
      "http://a.ml/vocabularies/document-source-maps#element": "http://a.ml/vocabularies/document#processingData",
