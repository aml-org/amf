      "http://a.ml/vocabularies/core#extensionName": "deprecated",
      "@id": "amf://id#118",
      "@type": [
        "http://a.ml/vocabularies/data#Scalar",
        "http://a.ml/vocabularies/data#Node",
        "http://a.ml/vocabularies/document#DomainElement"
