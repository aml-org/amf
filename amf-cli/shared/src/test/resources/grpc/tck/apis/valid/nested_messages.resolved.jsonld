            "http://a.ml/vocabularies/document-source-maps#value": [
              {
                "@value": "syntax = \"proto3\";\n\npackage foo;\n\nmessage OuterMessage {\n  message MiddleMessage {\n    message InnerMessage {\n      int32 deep_value = 1;\n    }\n    \n    InnerMessage inner = 1;\n    string middle_value = 2;\n  }\n  \n  MiddleMessage middle = 1;\n  string outer_value = 2;\n}\n\nmessage AnotherMessage {\n  OuterMessage.MiddleMessage.InnerMessage nested_reference = 1;\n}\n"
              }
            ]
          }
        ]
      }
