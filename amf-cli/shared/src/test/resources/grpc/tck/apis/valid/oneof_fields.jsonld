            "http://a.ml/vocabularies/document-source-maps#element": [
              {
                "@value": "file://amf-cli/shared/src/test/resources/grpc/tck/apis/valid/oneof_fields.proto"
              }
            ],
            "http://a.ml/vocabularies/document-source-maps#value": [
              {
                "@value": "syntax = \"proto3\";\n\npackage foo;\n\nmessage OneofFields {\n  oneof test_oneof {\n    string name = 1;\n    int32 id = 2;\n    NestedMessage message = 3;\n    NestedEnum enum_value = 4;\n  }\n  \n  string other_field = 5;\n  \n  oneof another_oneof {\n    bool flag = 6;\n    bytes data = 7;\n  }\n}\n\nmessage NestedMessage {\n  int32 value = 1;\n}\n\nenum NestedEnum {\n  NESTED_UNKNOWN = 0;\n  NESTED_VALUE = 1;\n}\n"
              }
            ]
          }
        ]
      }
    ],
