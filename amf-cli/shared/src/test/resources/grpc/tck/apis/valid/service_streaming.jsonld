            "@id": "file://amf-cli/shared/src/test/resources/grpc/tck/apis/valid/service_streaming.proto#/source-map/grpc-raw-proto/element_0",
            "http://a.ml/vocabularies/document-source-maps#element": [
              {
                "@value": "file://amf-cli/shared/src/test/resources/grpc/tck/apis/valid/service_streaming.proto"
              }
            ],
            "http://a.ml/vocabularies/document-source-maps#value": [
              {
                "@value": "syntax = \"proto3\";\npackage foo;\n\n\nmessage StreamRequest {\n  int32 id = 1;\n}\n\nmessage StreamResponse {\n  string data = 1;\n  int32 sequence = 2;\n}\n\nservice StreamingService {\n  rpc ServerStream(StreamRequest) returns (stream StreamResponse);\n  rpc ClientStream(stream StreamRequest) returns (StreamResponse);\n  rpc BidirectionalStream(stream StreamRequest) returns (stream StreamResponse);\n}\n"
              }
            ]
          }
        ]
      }
    ],
