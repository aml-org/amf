    {
      "@id": "amf://id#/source-map/grpc-raw-proto/element_0",
      "http://a.ml/vocabularies/document-source-maps#element": "amf://id",
      "http://a.ml/vocabularies/document-source-maps#value": "syntax = \"proto3\";\n\n// Some imports (real and well known)\nimport \"ref.proto\";\nimport \"google/protobuf/descriptor.proto\";\nimport \"google/protobuf/any.proto\";\n\n// Some options\noption java_multiple_files = true;\noption java_package = \"io.grpc.examples.all\";\noption java_outer_classname = \"AllExample\";\noption objc_class_prefix = \"HLW\";\n\npackage all;\n\n// Service definition, it matches to endpoint in AMF model\nservice Greeter {\n  option deprecated = false;\n  // Some RPCs, they match to operations in AMF model.\n  // Input match to request and output to response in AMF model\n  rpc PostExample (RequestMessage) returns (ResponseMessage) {\n    option deprecated = true;\n  }\n  rpc PublishExample (stream RequestMessage) returns (ResponseMessage) {}\n  rpc SubscribeExample (RequestMessage) returns (stream ResponseMessage) {}\n  rpc PubSubExample (stream RequestMessage) returns (stream ResponseMessage) {}\n}\n\n// Simple Message for Request\nmessage RequestMessage {\n  string a = 1;\n}\n\n// Simple Message for Response\nmessage ResponseMessage {\n  string a = 1;\n}\n\n// Some root level enum\nenum RootEnum {\n  SOMETHING = 0;\n}\n\n// Some complex message, using a little of everything\nmessage ComplexMessage {\n  // Map property\n  map<string, SearchRequest> searches = 3;\n  // OneOf property\n  oneof oneOfProperty {\n    string name = 18;\n  }\n  // Enum property\n  enum enumProperty {\n    UNIVERSAL = 0;\n    WEB = 1;\n    IMAGES = 2;\n    LOCAL = 3;\n    NEWS = 4;\n    PRODUCTS = 5;\n    VIDEO = 6;\n  }\n  // Enum reference\n  RootEnum something = 4;\n  // Nested Message\n  message NestedMessage1 {\n    string n1 = 1;\n    NestedMessage2 n2 = 2;\n    // Nested Message in nested Message\n    message NestedMessage2 {\n      string nn1 = 1;\n    }\n  }\n  // Reference to nested element\n  NestedMessage1.NestedMessage2 n3 = 10;\n  // Reference to root Message using package\n  .all.ComplexMessage.NestedMessage1 n4 = 11;\n  // Reference to external file Message\n  reference.RefMessage reference = 15;\n  // Some reservations\n  reserved 20;\n  reserved 21 to 25;\n  reserved 26, 27, 28 to 49;\n  reserved 50 to max;\n  reserved \"reserved_1\";\n  reserved \"reserved_2\", \"reserved_3\";\n  // Some properties with modificators\n  option deprecated = true;\n  repeated string complex_property = 1 [deprecated = true, packed = true];\n  string other_complex_property = 2 [(mystruct) = { a: \"hello\"}];\n}\n\n// Message with all types\nmessage SearchRequest {\n  bool bool_property = 1;\n  string string_property = 2;\n  bytes bytes_property = 3;\n  double double_property = 4;\n  fixed32 fixed32_property = 5;\n  fixed64 fixed64_property = 6;\n  sfixed32 sfixed32_property = 7;\n  sfixed64 sfixed64_property = 8;\n  float float_property = 9;\n  int32 int32_property = 10;\n  int64 int64_property = 11;\n  sint32 sint32_property = 12;\n  sint64 sint64_property = 13;\n  uint32 uint32_property = 14;\n  uint64 uint64_property = 15;\n}\n\n// Message using google.protobuf.Any import\nmessage Any {\n  google.protobuf.Any message = 1;\n  repeated google.protobuf.Any details = 2;\n  map<string, google.protobuf.Any> metadata = 3;\n}\n\n// Extension of google.protobuf.FieldOptions import\n// Extensions does not exists in proto3, but imports of proto2 google libs could be extended\nmessage MyOption {\n  string a = 1;\n  string b = 2;\n}\nextend google.protobuf.FieldOptions {\n  MyOption mystruct = 5124;\n}\n"
    },
    {
