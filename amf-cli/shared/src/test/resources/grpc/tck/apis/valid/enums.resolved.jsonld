            "http://a.ml/vocabularies/document-source-maps#value": [
              {
                "@value": "syntax = \"proto3\";\n\npackage org.test;\n\nenum TopLevelEnum {\n  TOP_LEVEL_UNKNOWN = 0;\n  TOP_LEVEL_VALUE1 = 1;\n  TOP_LEVEL_VALUE2 = 2;\n  TOP_LEVEL_VALUE3 = 3;\n}\n\nmessage EnumMessage {\n  enum NestedEnum {\n    NESTED_UNKNOWN = 0;\n    NESTED_VALUE1 = 1;\n    NESTED_VALUE2 = 2;\n  }\n  \n  TopLevelEnum top_enum = 1;\n  NestedEnum nested_enum = 2;\n  repeated TopLevelEnum repeated_enum = 3;\n}\n"
              }
            ]
          }
        ]
      }
    ],
