            "http://a.ml/vocabularies/document-source-maps#element": [
              {
                "@value": "file://amf-cli/shared/src/test/resources/grpc/tck/apis/valid/file_options.proto"
              }
            ],
            "http://a.ml/vocabularies/document-source-maps#value": [
              {
                "@value": "syntax = \"proto3\";\n\npackage com.example;\n\noption java_package = \"com.example.generated\";\noption java_outer_classname = \"TestProtos\";\noption java_multiple_files = true;\noption optimize_for = SPEED;\noption go_package = \"example.com/test\";\noption cc_enable_arenas = true;\n\nmessage FileOptionsMessage {\n  string value = 1;\n}\n"
              }
            ]
          }
        ]
      }
