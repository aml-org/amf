                "@value": "syntax = \"proto3\";\npackage foo;\n\n\n// Top-level comment for the file\n\n// Message comment\nmessage CommentedMessage {\n  // Field comment\n  string field1 = 1;\n  \n  int32 field2 = 2; // Inline comment\n  \n  /* Block comment\n     spanning multiple lines */\n  bool field3 = 3;\n}\n\n/* Service comment */\nservice CommentedService {\n  // Method comment\n  rpc GetData(CommentedMessage) returns (CommentedMessage);\n}\n"
