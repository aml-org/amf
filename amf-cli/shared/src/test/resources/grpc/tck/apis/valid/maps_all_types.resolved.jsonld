            "http://a.ml/vocabularies/document-source-maps#value": [
              {
                "@value": "syntax = \"proto3\";\n\npackage foo;\n\nmessage MapTypes {\n  map<int32, string> int_to_string = 1;\n  map<int64, string> int64_to_string = 2;\n  map<uint32, string> uint32_to_string = 3;\n  map<uint64, string> uint64_to_string = 4;\n  map<sint32, string> sint32_to_string = 5;\n  map<sint64, string> sint64_to_string = 6;\n  map<fixed32, string> fixed32_to_string = 7;\n  map<fixed64, string> fixed64_to_string = 8;\n  map<sfixed32, string> sfixed32_to_string = 9;\n  map<sfixed64, string> sfixed64_to_string = 10;\n  map<bool, string> bool_to_string = 11;\n  map<string, string> string_to_string = 12;\n  map<string, int32> string_to_int = 13;\n  map<string, NestedMessage> string_to_message = 14;\n  map<string, NestedEnum> string_to_enum = 15;\n}\n\nmessage NestedMessage {\n  string value = 1;\n}\n\nenum NestedEnum {\n  NESTED_UNKNOWN = 0;\n  NESTED_VALUE = 1;\n}\n"
              }
            ]
          }
        ]
      }
    ],
