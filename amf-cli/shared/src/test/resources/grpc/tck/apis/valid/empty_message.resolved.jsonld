              {
                "@value": "syntax = \"proto3\";\n\npackage foo;\n\nmessage EmptyMessage {\n}\n\nmessage ContainerMessage {\n  EmptyMessage empty = 1;\n  string value = 2;\n}\n\nservice EmptyService {\n  rpc DoNothing(EmptyMessage) returns (EmptyMessage);\n}\n"
